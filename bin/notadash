#!/usr/bin/env zsh
# maps · cassette.help · MIT
# notadash — nota/taskwarrior tmux dashboard
#
# Requires: tmux (pane-base-index 1), taskwarrior 3+
#
# Layout:
#   |  burndown.daily           |  nota bene (interactive TUI)      |
#   |                           |                                    |
#   |  task next (refresh 30s)  |                                    |
#   |  task overdue (refresh 60s) |                                  |
#   |  task calendar (full width, bottom strip)                      |
#
# Usage:
#   notadash          — launch (or re-attach if already running)
#   notadash kill     — kill the session
#   notadash refresh [pane|current]
#                    — refresh all data panes, one named pane, or the
#                      currently focused data pane inside tmux

SESSION="notadash"

# ── guards ────────────────────────────────────────────────────────────────────

command -v tmux &>/dev/null || { print -u2 "notadash: tmux not found"; exit 1 }
command -v task &>/dev/null || { print -u2 "notadash: taskwarrior not found"; exit 1 }

# ── helpers ───────────────────────────────────────────────────────────────────

_title_for() {
  [[ $1 == bene ]] && print "nota bene" || print "$1"
}

_pane_id() {
  local title
  title=$(_title_for "$1")
  tmux list-panes -s -t "$SESSION" -F "#{pane_title}	#{pane_id}" \
    | awk -F '	' -v t="$title" '$1 == t { print $2; exit }'
}

_pane_cmd() {
  case "$1" in
    burndown) print "clear; task burndown.daily" ;;
    calendar) print "clear; task calendar" ;;
    bene)     print "nota bene" ;;
    next)     print "while true; do clear; task next; sleep 30; done" ;;
    overdue)  print "while true; do clear; task overdue; sleep 60; done" ;;
    *) return 1 ;;
  esac
}

_refresh_pane() {
  local title=$1 pid cmd
  [[ $title == bene ]] && return 0
  pid=$(_pane_id "$title")
  [[ -n $pid ]] || return 1

  cmd=$(_pane_cmd "$title") || return 1
  tmux send-keys -t "$pid" C-c
  tmux send-keys -t "$pid" -l -- "$cmd"
  tmux send-keys -t "$pid" Enter
}

_current_pane_title() {
  local title
  title=$(tmux display-message -p "#{pane_title}")
  [[ $title == "nota bene" ]] && print bene || print "$title"
}

# ── kill ──────────────────────────────────────────────────────────────────────

if [[ $1 == kill ]]; then
  tmux kill-session -t "$SESSION" 2>/dev/null \
    && print "notadash: session killed" \
    || print "notadash: no active session"
  exit 0
fi

# ── refresh ───────────────────────────────────────────────────────────────────

if [[ $1 == refresh ]]; then
  tmux has-session -t "$SESSION" 2>/dev/null || { print -u2 "notadash: no session running"; exit 1 }
  local target=$2

  if [[ -z $target ]]; then
    _refresh_pane burndown
    _refresh_pane calendar
    _refresh_pane bene
    _refresh_pane next
    _refresh_pane overdue
    print "notadash: panes refreshed"
    exit 0
  fi

  if [[ $target == current ]]; then
    target=$(_current_pane_title) || {
      print -u2 "notadash: could not detect current pane"
      exit 1
    }
  fi

  _pane_cmd "$target" >/dev/null 2>&1 || {
    print -u2 "notadash: no refresh command for pane '$target'"
    exit 1
  }

  _refresh_pane "$target" || {
    print -u2 "notadash: pane '$target' not found"
    exit 1
  }

  print "notadash: refreshed $target"
  exit 0
fi

# ── attach if already running ─────────────────────────────────────────────────

if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach-session -t "$SESSION"
fi

# ── terminal size ─────────────────────────────────────────────────────────────

local sz
if sz=$(stty size 2>/dev/null) && [[ -n $sz ]]; then
  local ROWS=${sz%% *}
  local COLS=${sz##* }
else
  local ROWS=60
  local COLS=220
fi
(( ROWS -= 1 ))

[[ $ROWS -lt 20 || $COLS -lt 80 ]] && {
  print -u2 "notadash: terminal too small (${COLS}x${ROWS}, need 80x20+)"
  exit 1
}

# ── layout math ───────────────────────────────────────────────────────────────

local cal_rows=$(( ROWS / 7 ))
(( cal_rows < 5 )) && cal_rows=5
(( cal_rows > 10 )) && cal_rows=10
local top_rows=$(( ROWS - cal_rows - 1 ))

local bene_cols=$(( COLS * 60 / 100 ))
(( bene_cols < 80 )) && bene_cols=80
(( bene_cols > COLS - 30 )) && bene_cols=$(( COLS - 30 ))
local left_cols=$(( COLS - bene_cols - 1 ))
(( left_cols < 24 )) && {
  print -u2 "notadash: terminal too narrow (${COLS} cols, left column would collapse)"
  exit 1
}

local left_rows=$top_rows
local burn_rows=$(( left_rows * 50 / 100 ))
(( burn_rows < 10 )) && burn_rows=10
local next_rows=$(( left_rows * 30 / 100 ))
(( next_rows < 6 )) && next_rows=6
local overdue_rows=$(( left_rows - burn_rows - next_rows - 2 ))
(( overdue_rows < 5 )) && overdue_rows=5
local lower_rows=$(( next_rows + overdue_rows + 1 ))

local min_top=$(( burn_rows + next_rows + overdue_rows + 2 ))
if (( left_rows < min_top )); then
  print -u2 "notadash: terminal too short (${ROWS} rows). Use smaller font."
  exit 1
fi

# ── create session ────────────────────────────────────────────────────────────

tmux new-session -d -s "$SESSION" -n dash
tmux resize-window -t "$SESSION:dash" -x "$COLS" -y "$ROWS"

# ── splits — capture pane IDs to avoid visual-reindex issues ──────────────────

local P_burn P_cal P_bene P_next P_overdue

P_burn=$(tmux display-message -t "$SESSION:dash" -p "#{pane_id}")
P_cal=$(tmux split-window -v -l $cal_rows -t "$P_burn" -P -F "#{pane_id}")
P_bene=$(tmux split-window -h -l $bene_cols -t "$P_burn" -P -F "#{pane_id}")
P_next=$(tmux split-window -v -l $lower_rows -t "$P_burn" -P -F "#{pane_id}")
P_overdue=$(tmux split-window -v -l $overdue_rows -t "$P_next" -P -F "#{pane_id}")

# ── name panes (for refresh targeting) ───────────────────────────────────────

tmux select-pane -t "$P_burn"    -T "burndown"
tmux select-pane -t "$P_cal"     -T "calendar"
tmux select-pane -t "$P_bene"    -T "nota bene"
tmux select-pane -t "$P_next"    -T "next"
tmux select-pane -t "$P_overdue" -T "overdue"

sleep 0.3

# ── send commands ─────────────────────────────────────────────────────────────

tmux send-keys -t "$P_burn"    -l -- "clear; task burndown.daily"
tmux send-keys -t "$P_burn"    Enter
tmux send-keys -t "$P_cal"     -l -- "clear; task calendar"
tmux send-keys -t "$P_cal"     Enter
tmux send-keys -t "$P_bene"    -l -- "source ~/.zshrc 2>/dev/null; nota bene"
tmux send-keys -t "$P_bene"    Enter
tmux send-keys -t "$P_next"    -l -- "while true; do clear; task next; sleep 30; done"
tmux send-keys -t "$P_next"    Enter
tmux send-keys -t "$P_overdue" -l -- "while true; do clear; task overdue; sleep 60; done"
tmux send-keys -t "$P_overdue" Enter

# ── session-scoped keybinds ───────────────────────────────────────────────────

tmux bind-key -T prefix r run-shell "zsh ${0:A} refresh current"
tmux bind-key -T prefix R run-shell "zsh ${0:A} refresh"
tmux bind-key -T prefix B select-pane -t "$P_bene"
tmux bind-key -T prefix N select-pane -t "$P_next"
tmux bind-key -T prefix D select-pane -t "$P_overdue"
tmux bind-key -T prefix C select-pane -t "$P_cal"
tmux bind-key -T prefix U select-pane -t "$P_burn"

# ── focus bene and attach ─────────────────────────────────────────────────────

tmux select-pane -t "$P_bene"
exec tmux attach-session -t "$SESSION"
