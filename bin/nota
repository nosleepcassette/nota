#!/usr/bin/env python3
# maps · cassette.help · MIT
"""
nota — intelligent task CLI backed by taskwarrior

Commands:
  nota setup                            Install UDAs and contexts into ~/.taskrc
  nota add "text [inline syntax]"       Add task(s) — parses -> and :: syntax
  nota list [--project X] [--scope X]  List pending tasks grouped by project
  nota next                             Most urgent actionable tasks
  nota blocked                          Tasks blocked by unfinished dependencies
  nota show ID                          Full task detail
  nota done ID                          Mark task complete
  nota depend ID --on ID2               ID depends on ID2 (ID2 is prerequisite)
  nota annotate ID "note"               Add a note to a task
  nota projects                         Projects with task counts
  nota braindump "text" [--model ALIAS] [--dry-run]  LLM-parse → tasks
  nota log "habit"                      Log countable habit (multiple per day, e.g. cigarettes)
  nota mcp                              Start MCP stdio server

Inline syntax (used in `nota add`):
  ->   prerequisite:  "reply to pick n pull -> find stamps"
       (cannot complete left until right is done)
  ::   related-to:    "task A :: task B"
  p1–p4               priority (p1/p2 → H, p3 → M, p4 → L)
  @project            project assignment
  #tag                add tag
  scope:X             scope (meatspace/digital/server/etc.)
  due:DATE            due date (taskwarrior natural language: today/eow/friday/etc.)
"""

import argparse
import json
import os
import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_ROOT))

from src.parse import parse_inline
from src.tw import (
    task_add, task_get, task_list, task_next, task_blocked,
    task_done, task_depend, task_annotate, task_projects,
    task_modify, fmt_row, fmt_detail, _run, _run_json,
)
from src.scopes import list_scopes, add_scope as scope_add, rm_scope as scope_rm


# ── commands ──────────────────────────────────────────────────────────────────

def _priority_arg_to_parsed(value: str) -> int | None:
    """Normalize p1-p4 or H/M/L to nota's parsed priority integer."""
    if not value:
        return None
    pmap = {"p1": "1", "p2": "2", "p3": "3", "p4": "4", "h": "1", "m": "3", "l": "4"}
    pr = str(value).lower()
    if pr in pmap:
        return int(pmap[pr])
    return None


def _priority_arg_to_nlp(value: str) -> str | None:
    """Normalize p1-p4 or H/M/L to the H/M/L values used by NLP output."""
    if not value:
        return None
    pmap = {"p1": "H", "p2": "H", "p3": "M", "p4": "L", "h": "H", "m": "M", "l": "L"}
    return pmap.get(str(value).lower())


def _priority_arg_to_task(value: str) -> str | None:
    """Normalize p1-p4 or H/M/L to task_add priority_p."""
    if not value:
        return None
    pmap = {"p1": "p1", "p2": "p2", "p3": "p3", "p4": "p4", "h": "p1", "m": "p3", "l": "p4"}
    return pmap.get(str(value).lower())


def _apply_add_overrides(parsed: dict, args) -> None:
    """Apply explicit nota add flags over values parsed from inline syntax."""
    if getattr(args, "project", None):
        parsed["project"] = args.project
    if getattr(args, "scope", None):
        parsed["scope"] = args.scope
    if getattr(args, "due", None):
        parsed["due_date"] = args.due
    if getattr(args, "priority", None):
        pri = _priority_arg_to_parsed(args.priority)
        if pri is not None:
            parsed["priority"] = pri


def _apply_nlp_add_overrides(t: dict, args) -> None:
    """Apply explicit nota add flags over values inferred by NLP."""
    if getattr(args, "project", None):
        t["project"] = args.project
    if getattr(args, "scope", None):
        t["scope"] = args.scope
    if getattr(args, "due", None):
        t["due"] = args.due
    if getattr(args, "priority", None):
        pri = _priority_arg_to_nlp(args.priority)
        if pri:
            t["priority"] = pri


def _extract_embedded_add_flags(text: str, args) -> str:
    """Accept quoted smoke-test style '--project health' tokens inside title text."""
    flag_attrs = {
        "--project": "project",
        "-p": "project",
        "--scope": "scope",
        "-s": "scope",
        "--due": "due",
        "-d": "due",
        "--priority": "priority",
        "-r": "priority",
    }
    if not any(flag in text for flag in flag_attrs) and "--yes" not in text and "-y" not in text:
        return text
    try:
        import shlex

        parts = shlex.split(text)
    except ValueError:
        return text

    kept = []
    i = 0
    while i < len(parts):
        token = parts[i]
        if token in flag_attrs and i + 1 < len(parts):
            attr = flag_attrs[token]
            if not getattr(args, attr, None):
                setattr(args, attr, parts[i + 1])
            i += 2
        elif token in ("--yes", "-y"):
            args.yes = True
            i += 1
        else:
            kept.append(token)
            i += 1
    return " ".join(kept)


def _tags_list(value) -> list:
    if isinstance(value, list):
        return value
    if isinstance(value, str) and value.strip():
        return [value.strip()]
    return []


def _handle_url_add(url: str, args) -> None:
    """Fetch page title from URL and create task with URL annotated."""
    title = None
    try:
        import html
        import re
        import urllib.request

        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 nota/1.0"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            body = resp.read(8192).decode("utf-8", errors="ignore")
        m = re.search(r"<title[^>]*>(.*?)</title>", body, re.I | re.S)
        if m:
            title = html.unescape(m.group(1)).strip()[:120]
    except Exception:
        pass

    description = title or url
    print(f"  url: {url}")
    print(f"  title: {title or '(could not fetch)'}")

    task = task_add(
        description=description,
        project=getattr(args, "project", None) or "inbox",
        tags=["url"],
    )
    if task and task.get("id"):
        task_annotate(task["id"], url)
        print(f"+ [{task.get('id','?')}] {description}  (url)")
    else:
        print("  failed to create task", file=sys.stderr)


def cmd_setup(args):
    print("Setting up nota UDAs and contexts...")
    from src.setup import run_setup
    run_setup(verbose=True)


def cmd_add(args):
    from src.parse import _looks_freeform

    text = args.title
    text = _extract_embedded_add_flags(text, args)
    import re as _re

    if _re.compile(r"^https?://", _re.I).match(text):
        _handle_url_add(text, args)
        return

    advanced_flags = any([args.body, args.recur, args.until, args.wait, args.scheduled, args.json])
    use_nlp = not args.no_nlp and not advanced_flags and _looks_freeform(text)

    if use_nlp:
        try:
            from src.braindump import MODELS, _detect_fast_provider, _get_api_key

            model_alias = _detect_fast_provider()
            cfg = MODELS.get(model_alias, {})
            key_env = cfg.get("key_env")
            if not key_env or not _get_api_key(key_env):
                use_nlp = False
        except Exception:
            use_nlp = False

    if use_nlp:
        try:
            from src.braindump import _priority_map, nlp_single_task
            from src.scopes import is_valid_scope

            t = nlp_single_task(text)
            _apply_nlp_add_overrides(t, args)

            pri_display = t.get("priority", "M")
            due_display = t.get("due") or "-"
            scope_display = t.get("scope") or "-"
            tags = _tags_list(t.get("tags"))
            tags_display = ", ".join(tags) or "-"
            proj_display = t.get("project") or "inbox"
            desc_display = text

            if not args.yes:
                print(f"\n  \033[1;33m→\033[0m {desc_display}")
                print(f"     project: {proj_display}  |  priority: {pri_display}  |  due: {due_display}")
                print(f"     scope: {scope_display}  |  tags: {tags_display}")
                print(f"\n  \033[33m[enter] save  [e] edit fields  [n] cancel\033[0m  ", end="", flush=True)

                try:
                    choice = input().strip().lower()
                except (EOFError, KeyboardInterrupt):
                    print("\ncancelled")
                    return

                if choice == "n":
                    print("cancelled")
                    return

                if choice == "e":
                    new_proj = input(f"  project [{proj_display}]: ").strip() or proj_display
                    new_due = input(f"  due [{due_display}]: ").strip() or (t.get("due") or None)
                    new_scope = input(f"  scope [{scope_display}]: ").strip() or scope_display
                    new_tags_raw = input(f"  tags [{tags_display}]: ").strip()
                    new_tags = [x.strip() for x in new_tags_raw.split(",") if x.strip()] if new_tags_raw else tags
                    proj_display = new_proj
                    if new_due and new_due != "-":
                        t["due"] = new_due
                    else:
                        t["due"] = None
                    scope_display = new_scope if new_scope != "-" else ""
                    tags_display_list = new_tags
                else:
                    tags_display_list = tags
                    scope_display = t.get("scope") or ""
            else:
                tags_display_list = tags
                scope_display = t.get("scope") or ""

            scope = scope_display.strip() if scope_display else ""
            if not scope or not is_valid_scope(scope):
                scope = None
            priority_p = _priority_arg_to_task(args.priority) or _priority_map(str(t.get("priority", "M")).upper())
            task = task_add(
                description=text,
                project=proj_display or "inbox",
                priority_p=priority_p,
                due=t.get("due") or None,
                tags=tags_display_list if isinstance(tags_display_list, list) else [],
                scope=scope,
            )
            print(f"+ [{task.get('id','?')}] {task.get('description','')}  (nlp)")
            return
        except Exception as e:
            print(f"  [nlp failed: {e}, using inline parser]", file=sys.stderr)

    parsed = parse_inline(text)
    _apply_add_overrides(parsed, args)

    # Map p-priority to tw priority
    pri = parsed["priority"]
    pri_p = f"p{pri}"
    
    # Handle recurrence aliases
    recur = args.recur or parsed.get("recur")
    until = args.until or parsed.get("until")
    if recur:
        recur_map = {
            "daily": "daily", "weekly": "weekly", "biweekly": "biweekly",
            "monthly": "monthly", "quarterly": "quarterly", "annual": "annual",
            "weekdays": "weekdays",
        }
        if recur in recur_map:
            recur = recur_map[recur]
        # Recurring tasks need a due date
        if not parsed["due_date"]:
            print("Recurring tasks require a due date. Use due:DATE in title or --due flag.", file=sys.stderr)
            sys.exit(1)
    
    # Parse NL dates for wait/scheduled
    from src.dateparse import parse_date
    wait = parse_date(args.wait) if args.wait else None
    scheduled = parse_date(args.scheduled) if args.scheduled else None
    until_date = parse_date(until) if until else None

    # Create the main task
    task = task_add(
        description=parsed["title"],
        project=parsed["project"] if parsed["project"] != "inbox" else None,
        priority_p=pri_p,
        due=parsed["due_date"],
        tags=parsed["tags"],
        scope=parsed["scope"] or None,
        body=args.body or None,
        recur=recur,
        until=until_date,
        wait=wait,
        scheduled=scheduled,
    )
    main_id = task.get("id")

    created = [main_id] if main_id else []
    dep_ids = []

    # Create subtasks (prerequisites) and link depends
    for sub_title in parsed["subtasks"]:
        sub_parsed = parse_inline(sub_title)
        sub_task = task_add(
            description=sub_parsed["title"],
            project=(sub_parsed["project"] if sub_parsed["project"] != "inbox"
                     else (parsed["project"] if parsed["project"] != "inbox" else None)),
            priority_p=f"p{sub_parsed['priority']}",
            due=sub_parsed["due_date"],
            scope=sub_parsed["scope"] or parsed["scope"] or None,
        )
        sub_id = sub_task.get("id")
        if sub_id:
            created.append(sub_id)
            dep_ids.append(sub_id)

    # Set dependencies on main task (main depends on all subs)
    if main_id and dep_ids:
        _run(str(main_id), "modify", f"depends:{','.join(str(i) for i in dep_ids)}")

    # Handle related_to — create/find and annotate both sides
    for rel_title in parsed["related_titles"]:
        # Try to find existing task by description match
        all_tasks = task_list(status="pending", limit=500)
        existing = next(
            (t for t in all_tasks if rel_title.lower() in t.get("description", "").lower()),
            None
        )
        if existing:
            rel_id = existing["id"]
        else:
            rel_task = task_add(
                description=rel_title,
                project=parsed["project"] if parsed["project"] != "inbox" else None,
            )
            rel_id = rel_task.get("id")
            if rel_id:
                created.append(rel_id)

        if main_id and rel_id:
            task_annotate(main_id, f"related: [{rel_id}] {rel_title}")
            task_annotate(rel_id, f"related: [{main_id}] {parsed['title']}")

    if args.json:
        print(json.dumps({"created": created, "main_id": main_id}))
    else:
        t = task_get(main_id) if main_id else None
        if t:
            due_part = f"due:{parsed['due_date']}" if parsed["due_date"] else ""
            print(f"+ [{task.get('id','?')}] {task.get('description','')}  "
                  f"[{parsed['project']}] {due_part}")
        if len(created) > 1:
            print(f"  + {len(created)-1} linked task(s): {created[1:]}")


def cmd_capture(args):
    task = task_add(
        description=args.text.strip(),
        project=args.project or "inbox",
        priority_p=args.priority or "p3",
        due=None,
        tags=[],
        scope=args.scope or None,
    )
    tid = task.get("id", "?")
    print(f"+ [{tid}] {task.get('description','')}")


def cmd_list(args):
    tasks = task_list(
        project=args.project,
        scope=args.scope,
        priority_p=f"p{args.priority}" if args.priority else None,
        status="pending",
    )
    if args.json:
        print(json.dumps(tasks))
        return
    if not tasks:
        print("No tasks.")
        return
    by_project: dict = {}
    for t in tasks:
        proj = t.get("project") or "inbox"
        by_project.setdefault(proj, []).append(t)
    for proj in sorted(by_project):
        print(f"\n── {proj} ──")
        for t in by_project[proj]:
            print(fmt_row(t))


def cmd_next(args):
    import datetime

    if args.json:
        tasks = task_next(limit=args.limit)
        print(json.dumps(tasks))
        return

    tasks = task_list(status="pending", limit=100)
    today = datetime.date.today()
    this_week = today + datetime.timedelta(days=7)

    overdue, due_today, high_pri, this_week_tasks, inbox, rest = [], [], [], [], [], []

    def due_date(t):
        due = str(t.get("due") or "")
        if not due:
            return None
        try:
            if len(due) >= 15 and due[:8].isdigit() and due[8] == "T":
                dt = datetime.datetime.strptime(due[:15], "%Y%m%dT%H%M%S")
                if due.endswith("Z"):
                    dt = dt.replace(tzinfo=datetime.UTC).astimezone()
                return dt.date()
            if len(due) >= 8 and due[:8].isdigit():
                return datetime.date(int(due[:4]), int(due[4:6]), int(due[6:8]))
            if len(due) >= 10:
                iso = due[:19].replace("Z", "+00:00")
                dt = datetime.datetime.fromisoformat(iso)
                if dt.tzinfo:
                    dt = dt.astimezone()
                return dt.date()
        except Exception:
            return None
        return None

    for t in tasks:
        due = due_date(t)
        pri = t.get("priority", "")
        project = t.get("project") or ""

        if due and due < today:
            overdue.append(t)
        elif due == today:
            due_today.append(t)
        elif pri == "H":
            high_pri.append(t)
        elif due and due <= this_week:
            this_week_tasks.append(t)
        elif not project:
            inbox.append(t)
        else:
            rest.append(t)

    if not any([overdue, due_today, high_pri, this_week_tasks, inbox, rest]):
        print("Nothing ready.")
        return

    def fmt(t):
        tid = t.get("id", "?")
        desc = t.get("description", "")[:50]
        proj = f"  @{t['project']}" if t.get("project") else ""
        scope = f"  scope:{t['scope']}" if t.get("scope") else ""
        due = due_date(t)
        due_str = f"  due:{due.isoformat()}" if due else ""
        return f"  [{tid}] {desc}{proj}{scope}{due_str}"

    def section(title, items, total=None):
        if not items:
            return
        count = total if total is not None else len(items)
        print(f"\n── {title} ({count}) " + "─" * max(0, 44 - len(title) - 5))
        for t in items[:10]:
            print(fmt(t))

    section("OVERDUE", overdue)
    section("DUE TODAY", due_today)
    section("HIGH PRIORITY", high_pri)
    section("THIS WEEK", this_week_tasks)
    section("INBOX", inbox)
    if rest:
        section("OTHER", rest[:5], total=len(rest))
    print()


def cmd_blocked(args):
    tasks = task_blocked()
    if args.json:
        print(json.dumps(tasks))
        return
    if not tasks:
        print("Nothing blocked.")
        return
    print("\n── blocked ──")
    for t in tasks:
        print(fmt_row(t))


def cmd_show(args):
    t = task_get(args.id)
    if not t:
        print(f"Task {args.id} not found.", file=sys.stderr)
        sys.exit(1)
    if args.json:
        print(json.dumps(t))
    else:
        detail = fmt_detail(t)
        extras = []
        if t.get("recur"):
            extras.append(f"  Recur:    {t.get('recur')}")
        if t.get("until"):
            extras.append(f"  Until:    {(t.get('until') or '')[:8]}")
        if extras:
            detail = detail + "\n" + "\n".join(extras)
        print(detail)


def cmd_done(args):
    """Mark task(s) complete."""
    # Handle bulk IDs
    ids = []
    if hasattr(args, 'ids') and args.ids:
        ids = args.ids
    elif hasattr(args, 'id') and args.id:
        ids = [args.id]
    
    # Handle --project, --scope, --filter flags
    if args.project or args.scope or args.filter:
        tasks = task_list(
            project=args.project,
            scope=args.scope,
            status="pending",
            extra_filter=args.filter,
            limit=500,
        )
        ids = [t["id"] for t in tasks]
    
    if not ids:
        print("No tasks specified.", file=sys.stderr)
        sys.exit(1)
    
    results = []
    for task_id in ids:
        ok = task_done(task_id)
        results.append((task_id, ok))
    
    success = sum(1 for _, ok in results if ok)
    print(f"Completed {success}/{len(results)} task(s)")
    for task_id, ok in results:
        if ok:
            print(f"  ✓ [{task_id}]")
        else:
            print(f"  ✗ [{task_id}]")


def cmd_edit(args):
    """Edit an existing task."""
    task_id = args.id
    updates = {}
    
    if args.title:
        updates["description"] = args.title
    if args.project:
        updates["project"] = args.project
    if args.priority:
        updates["priority_p"] = f"p{args.priority}"
    if args.due:
        from src.dateparse import parse_date
        updates["due"] = parse_date(args.due) or args.due
    if args.scope:
        updates["scope"] = args.scope
    if args.add_tag:
        updates.setdefault("tags_add", []).append(args.add_tag)
    if args.rm_tag:
        updates.setdefault("tags_remove", []).append(args.rm_tag)
    if args.body:
        task_annotate(task_id, args.body)
    
    if updates:
        result = task_modify(task_id, **updates)
        if result:
            t = task_get(task_id)
            if t and args.json:
                print(json.dumps(t))
            elif t:
                print(f"Updated [{task_id}] {t['description']}")
        else:
            print(f"Failed to update task {task_id}.", file=sys.stderr)
            sys.exit(1)
    else:
        t = task_get(task_id)
        if t and args.json:
            print(json.dumps(t))
        elif t:
            print(fmt_detail(t))
        else:
            print(f"Task {task_id} not found.", file=sys.stderr)
            sys.exit(1)


def cmd_scopes(args):
    """List or manage scopes."""
    if args.add:
        ok = scope_add(args.add, args.emoji, args.description)
        if ok:
            print(f"Added scope: {args.add}")
        else:
            print(f"Scope '{args.add}' already exists or is a default.", file=sys.stderr)
            sys.exit(1)
    elif args.remove:
        ok = scope_rm(args.remove)
        if ok:
            print(f"Removed scope: {args.remove}")
        else:
            print(f"Scope '{args.remove}' not found or is a default.", file=sys.stderr)
            sys.exit(1)
    else:
        scopes = list_scopes()
        if args.json:
            print(json.dumps(scopes))
            return
        print("\n── scopes ──────────────────────────")
        for s in sorted(scopes, key=lambda x: x["name"]):
            emoji = s["emoji"] or "  "
            print(f"  {emoji}  {s['name']:<14} {s['description']}")
        print()


def cmd_move(args):
    """Move task(s) to another project."""
    ids = args.ids
    project = args.project
    
    results = []
    for task_id in ids:
        ok = task_modify(task_id, project=project)
        results.append((task_id, bool(ok)))
    
    success = sum(1 for _, ok in results if ok)
    print(f"Moved {success}/{len(results)} task(s) to @{project}")
    for task_id, ok in results:
        print(f"  {'✓' if ok else '✗'} [{task_id}]")


def cmd_tag(args):
    """Add/remove tags from task(s)."""
    ids = args.ids
    tags_add = args.add or []
    tags_rm = args.rm or []
    
    if not tags_add and not tags_rm:
        print("No tags specified. Use --add or --rm.", file=sys.stderr)
        sys.exit(1)
    
    results = []
    for task_id in ids:
        ok = task_modify(task_id, tags_add=tags_add, tags_remove=tags_rm)
        results.append((task_id, bool(ok)))
    
    success = sum(1 for _, ok in results if ok)
    print(f"Tagged {success}/{len(results)} task(s)")
    for task_id, ok in results:
        print(f"  {'✓' if ok else '✗'} [{task_id}]")


def cmd_depend(args):
    """Set dependency: task ID depends on task ID2."""
    ok = task_depend(args.id, args.on)
    if ok:
        print(f"[{args.id}] now depends on [{args.on}]")
    else:
        print("Failed to set dependency.", file=sys.stderr)
        sys.exit(1)


def cmd_relate(args):
    """Create relations between tasks using tags."""
    task_id = args.id
    target_id = args.to or args.blocks or args.subtask
    
    if not target_id:
        print("Specify --to, --blocks, or --subtask.", file=sys.stderr)
        sys.exit(1)
    
    if args.to:
        rel_type = "related"
    elif args.blocks:
        rel_type = "blocks"
    elif args.subtask:
        rel_type = "subtask"
    
    # Add tag to source task
    ok1 = task_modify(task_id, tags_add=[f"related:{target_id}"])
    
    # Add reverse tag to target task
    ok2 = task_modify(target_id, tags_add=[f"related:{task_id}"])
    
    if ok1 and ok2:
        print(f"Created {rel_type} relation: [{task_id}] ↔ [{target_id}]")
    else:
        print(f"Failed to create relation.", file=sys.stderr)
        sys.exit(1)


def cmd_related(args):
    """Show tasks related to a given task."""
    task_id = args.id
    t = task_get(task_id)
    
    if not t:
        print(f"Task {task_id} not found.", file=sys.stderr)
        sys.exit(1)
    
    tags = t.get("tags", [])
    related_ids = []
    for tag in tags:
        if tag.startswith("related:"):
            try:
                related_ids.append(int(tag.split(":")[1]))
            except:
                pass
    
    if not related_ids:
        print(f"No related tasks for [{task_id}]")
        return
    
    print(f"\n── related to [{task_id}] ─────────────────")
    for rid in related_ids:
        rt = task_get(rid)
        if rt:
            status = "✓" if rt.get("status") == "completed" else " "
            print(f"  [{rid}] {status} {rt.get('description','')}")
    print()


def cmd_tree(args):
    """Show dependency tree for a task."""
    task_id = args.id
    
    def get_depends(tid):
        t = task_get(tid)
        if not t:
            return []
        return t.get("depends", [])
    
    def render_tree(tid, prefix="", is_last=True):
        t = task_get(tid)
        if not t:
            return []
        
        status = "✓" if t.get("status") == "completed" else "○"
        desc = t.get("description", "")[:50]
        line = f"{prefix}[{tid}] {status} {desc}"
        lines = [line]
        
        deps = get_depends(tid)
        new_prefix = prefix + ("    " if is_last else "│   ")
        
        for i, dep_uuid in enumerate(deps):
            # Look up UUID to get ID
            found = _run_json(f"uuid:{dep_uuid}", "export")
            if found:
                dep_id = found[0].get("id")
                is_last_dep = (i == len(deps) - 1)
                connector = "└── " if is_last_dep else "├── "
                lines.extend(render_tree(dep_id, new_prefix + connector, is_last_dep))
        
        return lines
    
    print(f"\n── dependency tree for [{task_id}] ────────────")
    lines = render_tree(task_id, "", True)
    for line in lines:
        print(line)
    print()


