def cmd_cron_check(args):
    import datetime
    import urllib.error
    import urllib.request

    threshold = args.minutes
    now = datetime.datetime.now(datetime.UTC).replace(tzinfo=None)
    cutoff = now + datetime.timedelta(minutes=threshold)

    tasks = task_list(status="pending", limit=200)
    due_soon = []
    for t in tasks:
        due = t.get("due") or ""
        if not due:
            continue
        try:
            if due[:8].isdigit():
                dt = datetime.datetime.strptime(due[:15], "%Y%m%dT%H%M%S")
            else:
                dt = datetime.datetime.fromisoformat(due[:19])
            if now <= dt <= cutoff:
                due_soon.append(t)
        except Exception:
            continue

    if not due_soon:
        print("nota cron-check: no tasks due soon")
        return

    print(f"nota cron-check: {len(due_soon)} task(s) due within {threshold}m")
    for t in due_soon:
        print(f"  [{t.get('id')}] {t.get('description','')}  due:{t.get('due','')[:8]}")

    push_url = args.push_url or os.environ.get("NOTA_PUSH_URL", "")
    if not push_url:
        return

    payload = json.dumps({
        "due_soon": [
            {
                "id": t.get("id"),
                "description": t.get("description", ""),
                "project": t.get("project", ""),
                "due": t.get("due", ""),
            }
            for t in due_soon
        ]
    }).encode()

    token = os.environ.get("NOTA_WEBHOOK_TOKEN", "")
    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"

    try:
        req = urllib.request.Request(push_url, data=payload, headers=headers, method="POST")
        with urllib.request.urlopen(req, timeout=10) as resp:
            print(f"  pushed to {push_url} -> {resp.status}")
    except urllib.error.URLError as e:
        print(f"  push failed: {e}", file=sys.stderr)


def cmd_sync(args):
    import subprocess
    from datetime import datetime, timezone

    task_dir = Path.home() / ".task"
    sync_cfg = Path.home() / ".taskrc-sync"

    remote_url = args.remote
    if not remote_url and sync_cfg.exists():
        remote_url = sync_cfg.read_text().strip()
    if args.remote:
        sync_cfg.write_text(args.remote.strip())
        remote_url = args.remote.strip()
        print(f"saved remote: {remote_url}")

    def _git(*git_args, cwd=task_dir, check=True):
        return subprocess.run(
            ["git"] + list(git_args),
            cwd=cwd,
            capture_output=True,
            text=True,
            check=check,
        )

    if args.restore:
        if not remote_url:
            print("restore requires --remote URL", file=sys.stderr)
            return
        restore_dir = task_dir / "_restore"
        print(f"restoring from {remote_url}...")
        subprocess.run(["git", "clone", remote_url, str(restore_dir)], check=True)
        export_file = restore_dir / "export.json"
        if export_file.exists():
            subprocess.run(["task", "import", str(export_file)], check=True)
            print("restored.")
        return

    task_dir.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["task", "export"], capture_output=True, text=True)
    export_path = task_dir / "export.json"
    export_path.write_text(r.stdout)

    if not (task_dir / ".git").exists():
        _git("init")
        (task_dir / ".gitignore").write_text("*.lock\n")
        if remote_url:
            _git("remote", "add", "origin", remote_url)
        print("initialized git repo in ~/.task/")

    if remote_url:
        remotes = _git("remote", "-v", check=False).stdout
        if "origin" not in remotes:
            _git("remote", "add", "origin", remote_url)

    _git("add", "-A")
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    result = _git("commit", "-m", f"sync {timestamp}", check=False)
    if result.returncode != 0:
        combined = result.stdout + result.stderr
        if "nothing to commit" in combined or "no changes added" in combined:
            print("nothing to sync.")
            return
        print(combined.strip() or "git commit failed", file=sys.stderr)
        return

    if remote_url:
        push = _git("push", "-u", "origin", "main", check=False)
        if push.returncode != 0:
            push = _git("push", "-u", "origin", "master", check=False)
        if push.returncode == 0:
            print(f"synced to {remote_url}")
        else:
            print((push.stderr or push.stdout).strip() or "git push failed", file=sys.stderr)
    else:
        print("synced locally (no remote configured -- use --remote URL to set one)")


def cmd_track(args):
    """Record a habit as done (or n/s) for today."""
    from src.harsh import add_habit, log_habit, habit_names
    name = args.habit
    result = args.result
    if name not in habit_names():
        add_habit(name, frequency="0")
        print(f"New habit: {name}")
    written = log_habit(name, result=result, comment=args.note or "")
    glyphs = {"y": "✓", "n": "✗", "s": "~"}
    if written:
        print(f"{glyphs.get(result,'?')}  {name}")
    else:
        print(f"Already logged '{name}' today.")


def cmd_habit(args):
    """Show stats for a single habit."""
    from src.harsh import (
        get_streak, get_longest_streak, get_completion_rate, get_history, 
        count_today, habit_names, add_habit
    )
    
    name = args.habit
    if name not in habit_names():
        print(f"Habit '{name}' not found.", file=sys.stderr)
        sys.exit(1)
    
    if args.stats or (not args.streak and not args.history and not args.chart):
        # Default to full stats
        streak = get_streak(name)
        longest = get_longest_streak(name)
        rate_30 = get_completion_rate(name, days=30)
        rate_7 = get_completion_rate(name, days=7)
        today_count = count_today(name)
        
        print(f"\n── {name} ─────────────────────────────")
        print(f"  Today:      {today_count}")
        print(f"  Streak:    {streak} days")
        print(f"  Longest:   {longest} days")
        print(f"  7-day:     {rate_7:.0f}%")
        print(f"  30-day:    {rate_30:.0f}%")
        print()
    
    elif args.streak:
        streak = get_streak(name)
        print(f"{streak}")
    
    elif args.history:
        history = get_history(name, days=args.days)
        print(f"\n── {name} · last {args.days} days ──────────────")
        for entry in history[:args.days]:
            date_str = entry["date"][-5:]  # MM-DD
            bar = "█" * entry["count"] if entry["count"] > 0 else "·"
            print(f"  {date_str}  {bar} ({entry['count']})")
        print()


def cmd_habits(args):
    """Show today's habit status. Falls back to harsh CLI if available."""
    import subprocess as _sp
    from src.harsh import habit_names, today_results
    import datetime as _dt

    names = habit_names()
    if not names:
        print("No habits configured. Edit ~/.config/harsh/habits")
        return

    done = today_results()

    if args.json:
        print(json.dumps([{"name": n, "result": done.get(n)} for n in names]))
        return

    # Try harsh log --json for richer data, fall back to simple display
    richer = None
    try:
        r = _sp.run(["harsh", "log", "--json"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            richer = {h["name"]: h for h in __import__("json").loads(r.stdout).get("habits", [])}
    except Exception:
        pass

    today = _dt.date.today()
    print(f"\n── habits · {today} ──────────────────────────")
    print(f"  {'':3}  {'habit':<28}  {'freq':<6}  streak  last")
    print(f"  {'─'*3}  {'─'*28}  {'─'*6}  {'─'*6}  {'─'*10}")
    glyphs = {"y": "✓", "n": "✗", "s": "~", None: "○"}
    for name in names:
        result = done.get(name)
        glyph = glyphs.get(result, "○")
        if richer and name in richer:
            h = richer[name]
            streak = h.get("current_streak", 0) or 0
            freq = str(h.get("frequency", "?"))
            lc = h.get("last_completed", "")
            last = lc[:10] if lc else "never"
        else:
            streak = ""
            freq = ""
            last = "today" if result else ""
        print(f"  {glyph:3}  {name:<28}  {freq:<6}  {str(streak):<6}  {last}")
    print()


